# -----------------------------------------------------------------------------
# Copy to .env and adjust. These mirror the JPS manifest's settings block, so you
# have one place to see every knob and its default for the dev.civi.sioldata.com
# box at app.jpe.infomaniak.com.
# -----------------------------------------------------------------------------

# --- Identity / install ------------------------------------------------------
CIVICRM_SITE_URL=https://dev.civi.sioldata.com
CIVICRM_ADMIN_USER=admin
CIVICRM_ADMIN_EMAIL=admin@sioldata.com
CIVICRM_ADMIN_PASS=change-me-please
CIVICRM_DEMO_DATA=0
CIVICRM_SITE_KEY=

# --- Pinned versions ---------------------------------------------------------
CIVICRM_VERSION=6.18.2

# PHP ENGINE IS PINNED TO 8.4, NOT 8.5.
# dfc_civicrm's info.xml declares <php_compatibility> 8.1-8.4 only, and CiviCRM
# enforces that range. Raising the box to 8.5 stops `cv ext:enable` from
# registering the extension. To move: add <ver>8.5</ver> to the extension's
# info.xml first, then change the manifest's phpTag.
CIVICRM_PHP_VERSION=8.4.26

# Optional: sha256 of civicrm-<version>-standalone.tar.gz, verified on install.
CIVICRM_SHA256=

# --- Filesystem --------------------------------------------------------------
CIVICRM_APP_DIR=
CIVICRM_DATA_DIR=/var/lib/civicrm-data
CIVICRM_WEB_USER=

# --- Database ----------------------------------------------------------------
CIVICRM_DB_HOST=
CIVICRM_DB_PORT=3306
CIVICRM_DB_NAME=civicrm
CIVICRM_DB_USER=civicrm
CIVICRM_DB_PASS=change-me-please

# --- The extension under test ------------------------------------------------
# MUST equal the <key> in info.xml AND the directory CiviCRM resolves, because it
# loads the extension from <ext-dir>/<key>/<file>.php.
CIVICRM_EXT_KEY=dfc_civicrm

# dfc_civicrm has NO git remote and its vendor/ + composer.lock are gitignored,
# so there is nothing to clone and a clone would be missing the
# siol-data/dfc-connector runtime subset that export needs. Prefer the archive
# workflow (make ext-build / ext-install / ext-verify) and leave these blank.
# Only set EXT_SOURCE if you have pushed the extension to a remote.
CIVICRM_EXT_SOURCE=
CIVICRM_EXT_BRANCH=

# --- cv CLI ------------------------------------------------------------------
CV_BIN=
# CV_URL=https://download.civicrm.org/cv/cv.phar
